@model ProyectoFinal.Mvc.Models.Contabilidad.CuentasPagarVM
@{
    ViewData["Title"] = "Cuentas por Pagar";
}

<div class="container py-3">
    <h2>Cuentas por Pagar</h2>

    <div class="d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Listado</h4>
        <button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#crearCuenta">Nueva Cuenta</button>
    </div>

    <div id="crearCuenta" class="collapse mt-3">
        <form method="post" asp-controller="CuentasPagar" asp-action="Create">
            @Html.AntiForgeryToken()
            <div class="row g-2">
                <div class="col-sm-3">
                    <label class="form-label">Motivo</label>
                    <input name="Motivo" class="form-control" required />
                </div>
                <div class="col-sm-2">
                    <label class="form-label">Fecha</label>
                    <input type="date" name="FechaCuentaPagar" class="form-control" required />
                </div>
                <div class="col-sm-2">
                    <label class="form-label">Monto</label>
                    <input type="number" step="0.01" name="Monto" class="form-control" required />
                </div>
                <div class="col-sm-3">
                    <label class="form-label">Plazo Pagar</label>
                    <input name="PlazoPagar" class="form-control" />
                </div>
                <div class="col-sm-12">
                    <label class="form-label">Descripción</label>
                    <textarea name="Descripcion" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-2">
                <button class="btn btn-success" type="submit">Crear</button>
            </div>
        </form>
    </div>

    <div class="table-responsive mt-3">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Motivo</th>
                    <th>Fecha</th>
                    <th>Monto</th>
                    <th>Plazo</th>
                    <th>Descripción</th>
                    <th style="width:140px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Cuentas)
                {
                    <tr>
                        <td>@c.Motivo</td>
                        <td>@c.FechaCuentaPagar</td>
                        <td>@c.Monto</td>
                        <td>@c.PlazoPagar</td>
                        <td>@c.Descripcion</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalEditarCuenta"
                                    data-id="@c.IdCuentaPagar">
                                Editar
                            </button>

                            <form asp-controller="CuentasPagar" asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.IdCuentaPagar" />
                                <button class="btn btn-sm btn-outline-danger" type="submit"
                                        onclick="return confirm('¿Eliminar la cuenta \" @c.Motivo\"?');">
                                    Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Editar cuenta por pagar -->
<div class="modal fade" id="modalEditarCuenta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body" id="modalEditarCuentaBody">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEditarCuenta = document.getElementById('modalEditarCuenta');
        modalEditarCuenta.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-id');

            const url = '@Url.Action("Edit", "CuentasPagar")' + '/' + id;

            fetch(url)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('modalEditarCuentaBody').innerHTML = html;
                });
        });
    </script>
}