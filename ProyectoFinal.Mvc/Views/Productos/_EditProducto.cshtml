@model ProyectoFinal.Mvc.Models.Inventario.ProductoEditVM

<form method="post" asp-controller="Productos" asp-action="Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Producto.IdProducto" />

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="Producto.Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Precio</label>
        <input asp-for="Producto.Precio" type="number" step="0.01" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Tipo de Producto</label>
        <select asp-for="Producto.IdTipoProducto" class="form-select">
            <option value="">-- Seleccione --</option>
            @foreach (var tipo in Model.TiposProducto)
            {
                <option value="@tipo.IdTipoProducto">@tipo.NombreTipo</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">URL Imagen</label>
        <input asp-for="Producto.Imagen" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <textarea asp-for="Producto.Descripcion" class="form-control" rows="3"></textarea>
    </div>

    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </div>
</form>
