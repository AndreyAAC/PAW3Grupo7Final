@model List<ProyectoFinal.Models.DTOs.UsuarioAdminDTO>

@{
    ViewData["Title"] = "Administración de Usuarios";
}

<div class="container py-3">
    <h2 class="mb-3">Administración de Usuarios</h2>
    <p class="text-muted mb-3">
        Desde aquí puedes editar los datos de los usuarios y asignarles el rol adecuado (Usuario o Admin).
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Usuario</th>
                    <th>Nombre completo</th>
                    <th>Correo</th>
                    <th>Cédula</th>
                    <th>Teléfono</th>
                    <th>Rol</th>
                    <th style="width: 120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.IdUsuario</td>
                        <td>@u.NombreUsuario</td>
                        <td>@u.NombreApellido</td>
                        <td>@u.Correo</td>
                        <td>@u.Cedula</td>
                        <td>@u.Telefono</td>
                        <td>@(u.Role == 2 ? "Admin" : "Usuario")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary"
                               asp-controller="UsuariosAdmin"
                               asp-action="Edit"
                               asp-route-id="@u.IdUsuario">
                                Editar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>