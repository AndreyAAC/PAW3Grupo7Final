@model ProyectoFinal.Mvc.Models.Historial.HistorialCitasVM

@{
    ViewData["Title"] = "Historial de Citas";
}

<div class="container py-3">
    <h2>Historial de Citas</h2>

    <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
        <h4 class="mb-0">Listado</h4>
    </div>

    @if (Model.Citas == null || !Model.Citas.Any())
    {
        <div class="alert alert-info mt-3">
            No hay citas registradas en el historial.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle mt-3">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Motivo</th>
                    <th>Producto</th>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Detalle</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Citas)
                {
                    <tr>
                        <td>@c.NombreCliente</td>
                        <td>@c.Motivo</td>
                        <td>@(string.IsNullOrEmpty(c.NombreProducto) ? "-" : c.NombreProducto)</td>
                        <td>@c.FechaCita.ToString("dd/MM/yyyy")</td>
                        <td>@c.HoraCita.ToString("hh\\:mm")</td>
                        <td>@(string.IsNullOrEmpty(c.Detalle) ? "-" : c.Detalle)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
