@model ProyectoFinal.Models.DTOs.UsuarioLoginDTO

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout_Auth.cshtml";
}

<div class="auth-page">
    <div class="auth-card shadow-lg">
        <h2 class="text-center mb-2 fw-bold">Bienvenido</h2>
        <p class="text-center auth-subtitle mb-4">
            Inicia sesión para gestionar inventario, gastos y cuentas por pagar.
        </p>

        @if (TempData["RegisterSuccess"] != null)
        {
            <div class="alert alert-success text-center py-2">
                @TempData["RegisterSuccess"]
            </div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Correo" class="form-label fw-semibold">Correo electrónico</label>
                <input asp-for="Correo" class="form-control auth-input" type="email" required />
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contrasenia" class="form-label fw-semibold">Contraseña</label>
                <input asp-for="Contrasenia" class="form-control auth-input" type="password" required />
                <span asp-validation-for="Contrasenia" class="text-danger small"></span>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
            {
                <div class="text-danger mb-2 small">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-3">
                <a asp-action="ForgotPassword" class="text-decoration-none auth-link">
                    ¿Olvidé mi contraseña?
                </a>
            </div>

            <button type="submit" class="btn btn-primary w-100 auth-button">
                Iniciar sesión
            </button>

            <div class="mt-4 text-center">
                <span class="auth-text-muted">¿No tienes cuenta?</span>
                <a asp-action="Register" class="auth-link ms-1">Regístrate</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}