@using Microsoft.AspNetCore.Http

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isAuthPage = controller == "Account";

    var userName = Context.Session.GetString("UserName");
    var roleId = Context.Session.GetInt32("RoleId");
    var isAdmin = roleId == 2;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoFinal</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoFinal.Mvc.styles.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)

    <style>
        .app-navbar {
            background: linear-gradient(90deg, #0d6efd, #4f46e5);
        }

            .app-navbar .navbar-brand {
                font-weight: 700;
                letter-spacing: .03em;
            }

            .app-navbar .nav-link {
                position: relative;
                padding-inline: 0.9rem;
                transition: all .2s ease;
                border-radius: .5rem;
                margin-inline: .15rem;
            }

                .app-navbar .nav-link::after {
                    content: "";
                    position: absolute;
                    left: 12px;
                    right: 12px;
                    bottom: 4px;
                    height: 2px;
                    background: rgba(255, 255, 255, .9);
                    transform-origin: center;
                    transform: scaleX(0);
                    transition: transform .2s ease;
                }

                .app-navbar .nav-link:hover {
                    background-color: rgba(255, 255, 255, 0.14);
                    transform: translateY(-1px);
                }

                    .app-navbar .nav-link:hover::after {
                        transform: scaleX(1);
                    }

                .app-navbar .nav-link.active {
                    background-color: rgba(255, 255, 255, 0.22);
                }

        .user-pill {
            background-color: rgba(0, 0, 0, .15);
            border-radius: 999px;
            padding: .25rem .9rem;
            font-size: .9rem;
        }

            .user-pill span {
                font-weight: 500;
            }

            .user-pill small {
                font-size: .75rem;
                opacity: .9;
            }
        .auth-main {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at top left, #4f46e5 0, #0d6efd 40%, #020617 100%);
        }
    </style>
</head>
<body>
    @if (!isAuthPage)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark app-navbar shadow-sm">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        Control de Inventario
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Home" ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Gastos" ? "active" : "")"
                                   asp-controller="Gastos" asp-action="Index">Gastos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "CuentasPagar" ? "active" : "")"
                                   asp-controller="CuentasPagar" asp-action="Index">Cuentas por Pagar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Inventario" ? "active" : "")"
                                   asp-controller="Inventario" asp-action="Index">Inventario</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Productos" ? "active" : "")"
                                   asp-controller="Productos" asp-action="Index">Productos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "TiposProducto" ? "active" : "")"
                                   asp-controller="TiposProducto" asp-action="Index">Tipos de Producto</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Reportes" ? "active" : "")"
                                   asp-controller="Reportes" asp-action="Index">
                                    Reportes
                                </a>
                            </li>

                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(controller == "Usuarios" ? "active" : "")"
                                       asp-controller="UsuariosAdmin" asp-action="Index">
                                        Administración de Usuarios
                                    </a>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(userName))
                            {
                                <div class="text-white user-pill me-1">
                                    <span>Hola @userName</span>
                                    @if (isAdmin)
                                    {
                                        <small class="ms-2">(Admin)</small>
                                    }
                                </div>

                                <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light btn-sm">
                                        Cerrar sesión
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm">
                                    Iniciar sesión
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    @if (isAuthPage)
    {
        <main class="auth-main">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="border-top footer text-muted bg-light">
        <div class="container py-2 small text-center">
            &copy; @DateTime.Now.Year - ProyectoFinal.Mvc
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>