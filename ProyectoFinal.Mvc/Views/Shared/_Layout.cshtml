@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName");
    var roleId = HttpContextAccessor.HttpContext?.Session.GetInt32("RoleId") ?? 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoFinal.Mvc</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoFinal.Mvc.styles.css" asp-append-version="true" />

    <style>
        .menu-link {
            transition: 0.2s ease-in-out;
            font-weight: 500;
            position: relative;
        }

            .menu-link:hover {
                color: #0d6efd !important;
                transform: scale(1.05);
            }

            .menu-link::after {
                content: "";
                position: absolute;
                width: 0%;
                height: 2px;
                left: 50%;
                bottom: -2px;
                background-color: #0d6efd;
                transition: all 0.25s ease-in-out;
            }

            .menu-link:hover::after {
                width: 100%;
                left: 0;
            }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand menu-link" asp-controller="Home" asp-action="Index">
                    Inicio
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                        <li class="nav-item">
                            <a class="nav-link menu-link text-dark"
                               asp-controller="Gastos" asp-action="Index">
                                Gastos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link menu-link text-dark"
                               asp-controller="CuentasPagar" asp-action="Index">
                                Cuentas por Pagar
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link menu-link text-dark"
                               asp-controller="Inventario" asp-action="Index">
                                Inventario
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link menu-link text-dark"
                               asp-controller="Productos" asp-action="Index">
                                Productos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link menu-link text-dark"
                               asp-controller="TiposProducto" asp-action="Index">
                                Tipos de Producto
                            </a>
                        </li>

                        @* Solo admins ven este tab *@
                        @if (roleId == 2)
                        {
                            <li class="nav-item">
                                <a class="nav-link menu-link text-dark"
                                   asp-controller="UsuariosAdmin" asp-action="Index">
                                    Administración de Usuarios
                                </a>
                            </li>
                        }
                    </ul>


                    <div class="d-flex align-items-center">

                        @if (!string.IsNullOrEmpty(userName))
                        {
                            <span class="me-3 fw-bold">Hola @userName</span>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm"
                               asp-controller="Account" asp-action="Login">
                                Login
                            </a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container">
            &copy; 2025 - ProyectoFinal.Mvc
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>