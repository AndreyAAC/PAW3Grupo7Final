@model ProyectoFinal.Models.DTOs.TipoProductoDTO

<form method="post" asp-controller="TiposProducto" asp-action="Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdTipoProducto" />

    <div class="mb-3">
        <label class="form-label">Nombre del Tipo</label>
        <input asp-for="NombreTipo" class="form-control" />
    </div>

    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </div>
</form>
