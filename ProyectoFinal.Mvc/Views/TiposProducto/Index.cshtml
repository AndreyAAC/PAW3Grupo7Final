@model ProyectoFinal.Mvc.Models.Inventario.TiposProductoVM
@{
    ViewData["Title"] = "Tipos de Producto";
}

<div class="container py-3">
    <h2>Tipos de Producto</h2>

    <div class="d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Listado</h4>
        <button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#crearTipoProducto">
            Nuevo Tipo
        </button>
    </div>

    <div id="crearTipoProducto" class="collapse mt-3">
        <form method="post" asp-controller="TiposProducto" asp-action="Create">
            @Html.AntiForgeryToken()
            <div class="row g-2">
                <div class="col-sm-6">
                    <label class="form-label">Nombre del Tipo</label>
                    <input name="NombreTipo" class="form-control" required />
                </div>
            </div>
            <div class="mt-2">
                <button class="btn btn-success" type="submit">Crear</button>
            </div>
        </form>
    </div>

    <div class="table-responsive mt-3">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre del Tipo</th>
                    <th style="width:140px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Tipos)
                {
                    <tr>
                        <td>@t.NombreTipo</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalEditarTipoProducto"
                                    data-id="@t.IdTipoProducto">
                                Editar
                            </button>

                            <form asp-controller="TiposProducto" asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.IdTipoProducto" />
                                <button class="btn btn-sm btn-outline-danger" type="submit"
                                        onclick="return confirm('¿Eliminar el tipo \" @t.NombreTipo\"?');">
                                    Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalEditarTipoProducto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body" id="modalEditarTipoProductoBody">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEditarTipo = document.getElementById('modalEditarTipoProducto');
        modalEditarTipo.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-id');

            const url = '@Url.Action("Edit", "TiposProducto")' + '/' + id;

            fetch(url)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('modalEditarTipoProductoBody').innerHTML = html;
                });
        });
    </script>
}