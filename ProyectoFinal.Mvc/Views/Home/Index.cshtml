@model ProyectoFinal.Mvc.Models.Home.DashboardVM
@{
    ViewData["Title"] = "Inicio";
}

<div class="container my-4 dashboard-root">

    <div class="row g-3">
        <div class="col-lg-9">
            <div class="dashboard-hero-main shadow-sm">
                <h2 class="mb-2 fw-bold text-white">Bienvenido al Panel de Control</h2>
                <p class="mb-3 text-hero-subtitle">
                    Administra tus <strong>gastos</strong>, <strong>cuentas por pagar</strong> e
                    <strong>inventario</strong> desde un solo lugar.
                    Usa los accesos rápidos para navegar entre los módulos.
                </p>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Gastos" asp-action="Index"
                       class="btn btn-outline-light btn-sm d-inline-flex align-items-center hero-btn-secondary">
                        <span class="me-2">💵</span> Ver Gastos
                    </a>

                    <a asp-controller="CuentasPagar" asp-action="Index"
                       class="btn btn-outline-light btn-sm d-inline-flex align-items-center hero-btn-secondary">
                        <span class="me-2">📑</span> Cuentas por Pagar
                    </a>

                    <a asp-controller="Inventario" asp-action="Index"
                       class="btn btn-outline-light btn-sm d-inline-flex align-items-center hero-btn-secondary">
                        <span class="me-2">📦</span> Inventario
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="dashboard-hero-summary shadow-sm text-center">
                <p class="mb-2 text-uppercase small text-muted">Resumen rápido</p>

                <div class="hero-summary-grid mb-2">
                    <div>
                        <div class="hero-summary-label">Productos</div>
                        <div class="hero-summary-value">@Model.TotalProductos</div>
                    </div>
                    <div>
                        <div class="hero-summary-label">Gastos hoy</div>
                        <div class="hero-summary-value">₡@Model.GastosHoy.ToString("N2")</div>
                    </div>
                    <div>
                        <div class="hero-summary-label">Cuentas pendientes</div>
                        <div class="hero-summary-value">@Model.CuentasPendientes</div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="row g-3 mt-4">
        <div class="col-lg-4">
            <div class="module-card shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="mb-0">Gastos</h5>
                    <span class="module-tag module-tag-yellow">FINANZAS</span>
                </div>
                <p class="text-muted small mb-3">
                    Registra y consulta los movimientos de gasto para mantener un control claro de las salidas de dinero.
                </p>
                <a asp-controller="Gastos" asp-action="Index" class="module-link">Ir a Gastos →</a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="module-card shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="mb-0">Cuentas por Pagar</h5>
                    <span class="module-tag module-tag-red">PENDIENTES</span>
                </div>
                <p class="text-muted small mb-3">
                    Administra obligaciones pendientes, fechas límite y montos a pagar para evitar atrasos.
                </p>
                <a asp-controller="CuentasPagar" asp-action="Index" class="module-link">Ver Cuentas por Pagar →</a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="module-card shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="mb-0">Inventario</h5>
                    <span class="module-tag module-tag-green">OPERATIVO</span>
                </div>
                <p class="text-muted small mb-3">
                    Controla existencias, movimientos y productos disponibles para venta o uso interno.
                </p>
                <a asp-controller="Inventario" asp-action="Index" class="module-link">Ir al Inventario →</a>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-3">
        <div class="col-lg-6">
            <div class="module-card shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="mb-0">Productos</h5>
                    <span class="module-tag module-tag-green-soft">CATÁLOGO</span>
                </div>
                <p class="text-muted small mb-3">
                    Administra el catálogo de productos, sus precios, descripciones e imágenes.
                </p>
                <a asp-controller="Productos" asp-action="Index" class="module-link">Gestionar Productos →</a>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="module-card shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="mb-0">Tipos de Producto</h5>
                    <span class="module-tag module-tag-gray">CONFIGURACIÓN</span>
                </div>
                <p class="text-muted small mb-3">
                    Organiza los productos por tipo para facilitar búsquedas, reportes y control del inventario.
                </p>
                <a asp-controller="TiposProducto" asp-action="Index" class="module-link">Ver Tipos de Producto →</a>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-3 mb-4">
        <div class="col-lg-7">
            <div class="module-card shadow-sm">
                <h5 class="mb-3">Sugerencias de uso</h5>
                <ul class="text-muted small mb-0">
                    <li>Revisa los gastos al menos una vez al día para mantener tus registros al día.</li>
                    <li>Usa el módulo de Cuentas por Pagar para priorizar pagos según su fecha límite.</li>
                    <li>Actualiza el inventario cuando entren o salgan productos para evitar diferencias físicas.</li>
                    <li>Clasifica bien tus productos por tipo para mejorar la organización general del sistema.</li>
                </ul>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="module-card shadow-sm">
                <h5 class="mb-3 text-center">Accesos rápidos</h5>
                <div class="d-grid gap-2">
                    <a asp-controller="Gastos" asp-action="Index" class="quick-action-btn">
                        + Registrar nuevo gasto
                    </a>
                    <a asp-controller="CuentasPagar" asp-action="Index" class="quick-action-btn">
                        + Agregar cuenta por pagar
                    </a>
                    <a asp-controller="Productos" asp-action="Index" class="quick-action-btn">
                        + Crear producto
                    </a>
                    <a asp-controller="Inventario" asp-action="Index" class="quick-action-btn">
                        Ver inventario completo
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>